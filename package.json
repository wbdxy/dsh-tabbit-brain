{
  "name": "dsh-tabbit-brain",
  "version": "0.11.0",
  "description": "DeepSeek Harness subagent provider that mounts a clean preset for Tabbit-proxied models — lets a capable main agent delegate pure-reasoning work to models that have no tool calling.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "subagent",
    "agent-delegation",
    "tabbit",
    "llm",
    "context-isolation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbdxy/dsh-tabbit-brain.git"
  },
  "bugs": {
    "url": "https://github.com/wbdxy/dsh-tabbit-brain/issues"
  },
  "homepage": "https://github.com/wbdxy/dsh-tabbit-brain#readme",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "SETUP.md",
    "SETUP.zh.md",
    "scripts",
    "gateway-patch",
    "tools",
    "REVERSE-PROXY.md",
    "REVERSE-PROXY.zh.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 || >=0.1.2-alpha.1",
    "@deepseek-ai/dsh-brand": ">=0.1.1-rc.2 || >=0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 || >=0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 || >=0.1.2-alpha.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.1-rc.2 || >=0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-subagent": ">=0.1.1-rc.2 || >=0.1.2-alpha.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "scripts": {
    "check": "node --check lib/index.js",
    "setup": "node scripts/setup.mjs",
    "scan": "node tools/scan-secrets.mjs",
    "audit:docs": "node tools/audit-docs.mjs"
  }
}
